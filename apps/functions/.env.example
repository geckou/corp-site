# Functions 固有の環境変数
# firebase emulators や deploy 時に使用される
# ローカル開発では apps/functions/.env にコピーして値を入力

# layer:billing:start
# RevenueCat Webhook の Authorization ヘッダーに設定した値
# RevenueCat Dashboard > Integrations > Webhooks > Authorization header
# （apps/functions/src/revenuecat-webhook.ts が受信ヘッダーとこの値を突き合わせる）
REVENUECAT_WEBHOOK_AUTH=
# layer:billing:end

# 外部 API キー（例）
# OPENAI_API_KEY=
# GOOGLE_SHEETS_ID=

# 問い合わせフォームのタイポ判定
# 許可オリジン（カンマ区切り）。CORS + ハンドラ内 Origin 照合に使用。
# 例: http://localhost:3000,https://dev.example.com,https://example.com
ALLOWED_ORIGINS=
# 提供 AI 判定 API のエンドポイント（ブラウザ非露出）
TYPO_CHECK_API_URL=
# 提供 AI 判定 API のキー（ブラウザ非露出）
TYPO_CHECK_API_KEY=
