# Functions 固有の環境変数
# firebase emulators や deploy 時に使用される
# ローカル開発では apps/functions/.env にコピーして値を入力

# layer:billing:start
# REVENUECAT_WEBHOOK_AUTH は秘密なのでここには置かない。Secret Manager に登録する:
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_AUTH
# （RevenueCat Dashboard > Integrations > Webhooks > Authorization header に設定した値。
#   エミュレーターでは apps/functions/.secret.local に書く。→ src/lib/secrets.ts）
# layer:billing:end

# 外部 API キー（例）
# OPENAI_API_KEY=
# GOOGLE_SHEETS_ID=

# 問い合わせフォームのタイポ判定
# 許可オリジン（カンマ区切り）。CORS + ハンドラ内 Origin 照合に使用。
# 例: http://localhost:3000,https://dev.example.com,https://example.com
ALLOWED_ORIGINS=
# 判定 API のキー（TYPO_CHECK_API_KEY）は秘密なのでここには置かない。Secret Manager に登録する:
#   firebase functions:secrets:set TYPO_CHECK_API_KEY
# （エミュレーターでは apps/functions/.secret.local に書く）
