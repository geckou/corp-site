{
  "name": "@geckou/functions",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:firebase-admin --external:firebase-functions --external:express --external:cors",
    "dev": "yarn build && firebase emulators:start --only functions",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "yarn build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@geckou/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@geckou/eslint-config": "^0.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
