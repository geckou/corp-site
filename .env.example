# =============================================================
# 環境変数テンプレート
#
# このファイルを各環境用にコピーして値を入力する:
#   cp .env.example .env.develop
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# 編集後、使う環境に切り替える:
#   yarn env:develop   # .env.develop → .env.local にコピー + firebase use develop
#   yarn env:staging
#   yarn env:production
#
# 環境ごとに変える主な値:
#   BASIC_AUTH_CREDENTIALS（production は未設定）
#   NEXT_PUBLIC_API_BASE_URL / EXPO_PUBLIC_API_BASE_URL
#   NEXT_PUBLIC_GTM_ID
#   NEXT_PUBLIC_SENTRY_DSN / SENTRY_DSN / EXPO_PUBLIC_SENTRY_DSN
#   Firebase 設定値（プロジェクトを分けている場合）
#
# CI 自動デプロイでは、これらのファイル全文を GitHub Secrets に登録する:
#   gh secret set ENV_FILE_DEVELOP < .env.develop
#   gh secret set ENV_FILE_STAGING < .env.staging
# 詳細は README「環境変数の設定」/ .claude/docs/git-workflow.md を参照。
# =============================================================

# === Basic 認証（dev/stg のみ） ===
# user:password 形式。設定すると全ページに Basic 認証がかかる
# production では設定しないこと
# BASIC_AUTH_CREDENTIALS=user:password

# === contact-sample ページ専用 Basic 認証 ===
# user:password 形式。設定すると /contact-sample に Basic 認証がかかる
# 全環境で設定可能（production 含む）
# CONTACT_TEST_AUTH=user:password

# === Analytics（任意: 不要なら空のままでOK） ===
NEXT_PUBLIC_GTM_ID=

# layer:firebase:start
# === Web (Next.js) ===
# Firebase Console > Project Settings > General > Web app から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# layer:firebase:end

# layer:mobile:start
# === Mobile (Expo) ===
# app.config.ts の extra で参照される環境変数
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# layer:mobile:end

# layer:firebase:start
# === Server-side (firebase-admin for Next.js SSR) ===
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ダウンロードした JSON を1行の文字列にして設定する:
#   macOS: cat service-account.json | jq -c . | pbcopy
#   そのまま貼り付け
# ローカルでは GOOGLE_APPLICATION_CREDENTIALS の方が簡単（下記参照）
FIREBASE_SERVICE_ACCOUNT_KEY=
# layer:firebase:end

# layer:billing:start
# === RevenueCat ===
# RevenueCat Dashboard > Projects > API Keys から取得
# Web（NEXT_PUBLIC_ はブラウザに露出する）
NEXT_PUBLIC_REVENUECAT_API_KEY=
# layer:billing,mobile:start
# Mobile（iOS / Android それぞれ）
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=
# layer:billing,mobile:end
# layer:billing:end

# layer:firebase:start
# === Firebase Emulator (ローカル開発用) ===
# 本番では不要（ADC を使用）
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# layer:firebase:end

# --- API ---
# layer:functions:start
NEXT_PUBLIC_API_BASE_URL=
# layer:functions:end
# layer:mobile:start
EXPO_PUBLIC_API_BASE_URL=
# layer:mobile:end

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
# layer:functions:start
SENTRY_DSN=
# layer:functions:end
# layer:mobile:start
EXPO_PUBLIC_SENTRY_DSN=
# layer:mobile:end

# layer:billing:start
# --- RevenueCat Webhook（Functions） ---
# RevenueCat Dashboard > Integrations > Webhooks の Authorization header に設定した値。
# apps/functions/src/revenuecat-webhook.ts が受信ヘッダーとこの値を突き合わせる
REVENUECAT_WEBHOOK_AUTH=
# layer:billing:end

# layer:functions:start
# --- 問い合わせフォーム タイポ判定（Functions） ---
# 許可オリジン（カンマ区切り）。CORS + ハンドラ内 Origin 照合に使用
ALLOWED_ORIGINS=
# 提供 AI 判定 API のエンドポイント／キー（ブラウザ非露出）
TYPO_CHECK_API_URL=
TYPO_CHECK_API_KEY=
# layer:functions:end
